# ==============================================================================
# AI ScrumOS — Backend Production Configuration Template
# ==============================================================================

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=true
ENVIRONMENT=development

# CORS Settings (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Providers (OpenAI, Anthropic, Gemini, etc.)
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Vector Database (Weaviate, Qdrant, Chroma, etc. for RAG)
VECTOR_DB_URL=http://localhost:8080
VECTOR_DB_API_KEY=your-vector-db-key-here

# Enterprise Relational Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/aiscrumos

# SaaS Integrations (For real-time telemetry webhook pipelines)
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token-here

SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_SIGNING_SECRET=your-slack-signing-secret-here

JIRA_API_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=user@company.com
JIRA_API_TOKEN=your-jira-api-token-here

# AssemblyAI / Whisper (For Voice transcriptions)
AUDIO_TRANSCRIPTION_KEY=your-transcription-api-key-here
